# Server: copy to .env.docker. Never commit the real file.
VERIMATH_IMAGE=docker.cnb.cool/azurekiln/verimath-agent:latest
VERIMATH_BIND_HOST=127.0.0.1
VERIMATH_PORT=8765
WATCHTOWER_POLL_INTERVAL=600

MODEL_ENABLED=true
MODEL_API_BASE=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=
# Optional vision model on the same endpoint. Blank reuses MODEL_NAME.
OCR_MODEL_NAME=
MODEL_MAX_OUTPUT_TOKENS=8192
AGENT_TIMEOUT_SECONDS=180

CORPUS_WHITELIST=/corpus
CORPUS_AUTO_INDEX=true
DATA_DIR=/data
RETRIEVAL_LIMIT=4
A2A_ENFORCE_SIGNATURE=false
A2A_ACCESS_KEY=
A2A_SECRET_KEY=
