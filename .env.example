# Local POC paths. Semicolon-separated on Windows.
CORPUS_WHITELIST=E:\windows_ext\Desktop\个人\学习\概率论;E:\windows_ext\Desktop\个人\学习\数分高代;E:\windows_ext\Desktop\华为智能体\xiaoyi-a2a-stat-tutor\corpus\curated\public_main
DATA_DIR=.data

# Keep false for local protocol work. Enable before public deployment.
A2A_ENFORCE_SIGNATURE=false
A2A_ACCESS_KEY=
A2A_SECRET_KEY=
A2A_SIGNATURE_WINDOW_SECONDS=900

# Optional OpenAI-compatible model endpoint. DeepSeek official base URL is used by default.
# Put the real key in your local environment only; never commit it.
MODEL_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_ENABLED=false

MAX_HISTORY_TURNS=8
RETRIEVAL_LIMIT=4
