# Local POC paths. Semicolon-separated on Windows.
CORPUS_WHITELIST=corpus/curated/public_main
DATA_DIR=.data

# Keep false for local protocol work. Enable before public deployment.
A2A_ENFORCE_SIGNATURE=false
A2A_ACCESS_KEY=
A2A_SECRET_KEY=
A2A_SIGNATURE_WINDOW_SECONDS=900

# Model calls are enabled by default. Set MODEL_ENABLED=false for offline development.
# Put the real key in your local environment only; never commit it.
MODEL_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_THINKING=true
MODEL_NAME=deepseek-v4-flash
# Optional vision model on the same API endpoint; blank reuses MODEL_NAME.
OCR_MODEL_NAME=
MODEL_ENABLED=true
MODEL_MAX_OUTPUT_TOKENS=8192
AGENT_TIMEOUT_SECONDS=180

MAX_HISTORY_TURNS=8
RETRIEVAL_LIMIT=4
